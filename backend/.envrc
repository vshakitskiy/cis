# This is configuration file for direnv, a tool that will automatically
# configure your environment for you when you `cd` into a directory.
#
# For more information on direnv see its documentation: https://direnv.net/
#

# Default non-secret environment variables
# If you wish to use different values set them in `./overrides.env`

export DATABASE_URL=postgres://admeanie:assword@localhost:5432/dev?sslmode=disable
export JWT_SECRET=dev-secret-change-in-production
export SERVER_PORT=8080

dotenv_if_exists ./overrides.env
direnv_version 2
